-- V1__init_mrooj_schema.sql

CREATE TABLE users (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    phone VARCHAR(20),
    role VARCHAR(50) NOT NULL,
    enabled BOOLEAN DEFAULT TRUE,
    preferred_language VARCHAR(5) DEFAULT 'ar',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE farmers (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL UNIQUE,
    farm_name VARCHAR(255),
    farm_location POINT NOT NULL SRID 4326,
    region VARCHAR(100),
    farm_size_acres DOUBLE,
    crop_types VARCHAR(255),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_farmer_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    SPATIAL INDEX idx_farm_location (farm_location)
);

CREATE TABLE consultants (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL UNIQUE,
    specialty_domain VARCHAR(100),
    specialty_tags VARCHAR(255),
    location POINT NOT NULL SRID 4326,
    current_load INT DEFAULT 0,
    experience_years INT,
    rating DOUBLE DEFAULT 0.0,
    available BOOLEAN DEFAULT TRUE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_consultant_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    SPATIAL INDEX idx_consultant_location (location)
);

CREATE TABLE bookings (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    farmer_id BIGINT NOT NULL,
    assigned_consultant_id BIGINT,
    domain VARCHAR(50) NOT NULL,
    subject_type VARCHAR(100),
    issue_category VARCHAR(100),
    description TEXT,
    symptoms_image_url VARCHAR(500),
    ai_report JSON,
    location POINT NOT NULL SRID 4326,
    consultant_response TEXT,
    status VARCHAR(50) DEFAULT 'PENDING',
    version INT DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_booking_farmer FOREIGN KEY (farmer_id) REFERENCES farmers(id),
    CONSTRAINT fk_booking_consultant FOREIGN KEY (assigned_consultant_id) REFERENCES consultants(id)
);

CREATE TABLE assignment_log (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    booking_id BIGINT NOT NULL,
    consultant_id BIGINT NOT NULL,
    assigned_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    responded_at DATETIME,
    outcome VARCHAR(50),
    CONSTRAINT fk_log_booking FOREIGN KEY (booking_id) REFERENCES bookings(id),
    CONSTRAINT fk_log_consultant FOREIGN KEY (consultant_id) REFERENCES consultants(id)
);

CREATE TABLE appointments (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    booking_id BIGINT NOT NULL UNIQUE,
    farmer_id BIGINT NOT NULL,
    consultant_id BIGINT NOT NULL,
    scheduled_at DATETIME NOT NULL,
    duration_minutes INT DEFAULT 30,
    status VARCHAR(50) DEFAULT 'SCHEDULED',
    meeting_link VARCHAR(500),
    location VARCHAR(255),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_app_booking FOREIGN KEY (booking_id) REFERENCES bookings(id),
    CONSTRAINT fk_app_farmer FOREIGN KEY (farmer_id) REFERENCES farmers(id),
    CONSTRAINT fk_app_consultant FOREIGN KEY (consultant_id) REFERENCES consultants(id)
);

CREATE TABLE learning_articles (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL UNIQUE,
    content TEXT,
    category VARCHAR(100),
    target_domain VARCHAR(50),
    language VARCHAR(5) DEFAULT 'ar',
    author_name VARCHAR(100),
    published BOOLEAN DEFAULT FALSE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    published_at DATETIME
);